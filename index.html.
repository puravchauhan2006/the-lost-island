
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>The Lost Island</title>
<script src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>
<style>
*{box-sizing:border-box}
body{margin:0;background:#10251e;color:white;font-family:Arial;text-align:center}
header{padding:14px;background:#18382b}
h1{color:#ffd166;margin:5px;font-size:28px}
p{color:#c5d9cb}
button,input{padding:11px;border:0;border-radius:8px;margin:4px;font-weight:bold}
button{background:#ffd166;color:#172a20}
input{width:150px}
#status{font-size:13px;color:#a9e6c4;margin:10px}
#game{width:96%;max-width:900px;border:3px solid #a9c89d;border-radius:12px;background:#32734d;touch-action:none}
.stats{display:flex;justify-content:center;gap:18px;flex-wrap:wrap;padding:12px}
.stats b{color:#ffd166}
.controls{margin:12px auto;display:grid;grid-template-columns:55px 55px 55px;grid-template-rows:48px 48px 48px;gap:5px;justify-content:center}
.controls button{font-size:20px;background:#426c55;color:white;touch-action:none}
.up{grid-column:2}.left{grid-column:1;grid-row:2}
.down{grid-column:2;grid-row:2}.right{grid-column:3;grid-row:2}
@media(min-width:700px){.controls{display:none}}
.small{font-size:12px;color:#b9d5c4;padding:0 15px 20px}
</style>
</head>
<body>
<header>
<h1>🏝️ THE LOST ISLAND</h1>
<p>Explore • Collect • Survive • Compete</p>
</header>

<div>
<button onclick="createRoom()">CREATE ROOM</button>
<input id="room" placeholder="Enter room ID">
<button onclick="joinRoom()">JOIN ROOM</button>
</div>
<button onclick="copyRoom()">COPY ROOM ID</button>
<div id="status">Create a room or join a friend's room.</div>

<canvas id="game" width="900" height="550"></canvas>

<div class="stats">
<span>👥 Players: <b id="count">1</b>/8</span>
<span>🪙 Coins: <b id="score">0</b></span>
<span>🗝️ Team keys: <b id="keycount">0</b>/3</span>
</div>
<h3 id="message">Find the three hidden keys!</h3>

<div class="controls">
<button class="up" data-k="up">▲</button>
<button class="left" data-k="left">◀</button>
<button class="down" data-k="down">▼</button>
<button class="right" data-k="right">▶</button>
</div>

<div class="small">
Computer: Use arrow keys or WASD to move.<br>
Mobile: Use the direction buttons.<br>
Collect coins for your own score. Find three keys together to unlock the ancient gate!
</div>

<script>
const canvas=document.getElementById("game");
const ctx=canvas.getContext("2d");
const W=900,H=550;

let peer=null,host=false,roomId="";
let connections=[];
let players={};
let coins=[],keys=[];
let teamKeys=0;
let score=0;
let pressed={};
let myId="";

const me={x:80,y:80,score:0,color:"#ffd166"};

function say(t){
 document.getElementById("status").textContent=t;
}

function message(t){
 document.getElementById("message").textContent=t;
}

function random(a,b){
 return Math.random()*(b-a)+a;
}

function setupWorld(){
 coins=[];
 keys=[];
 for(let i=0;i<24;i++){
  coins.push({x:random(40,850),y:random(40,510),taken:false});
 }
 for(let i=0;i<3;i++){
  keys.push({x:180+i*260,y:random(130,420),taken:false});
 }
}
setupWorld();

function createRoom(){
 if(!window.Peer){say("Internet connection required. Refresh and try again.");return}
 host=true;
 peer=new Peer();

 peer.on("open",id=>{
  roomId=id;
  myId=id;
  players[id]=me;
  say("Room created! Share this ID: "+id);
  sync();
 });

 peer.on("connection",conn=>{
  if(Object.keys(players).length>=8){
   conn.on("open",()=>conn.send({type:"full"}));
   return;
  }

  let p={
   x:random(60,840),y:random(60,490),
   score:0,color:["#75e0b3","#ff8fab","#8be9fd","#c4a7e7"][Object.keys(players).length%4]
  };
  players[conn.peer]=p;
  connections.push(conn);

  conn.on("open",()=>{
   conn.send({type:"state",state:getState()});
   sync();
   say("A new explorer joined!");
  });

  conn.on("data",data=>{
   if(data.type==="move"){
    let player=players[conn.peer];
    if(player){
     player.x=data.x;
     player.y=data.y;
     collect(conn.peer);
     sync();
    }
   }
  });

  conn.on("close",()=>{
   delete players[conn.peer];
   sync();
  });
 });
 peer.on("error",e=>say("Room error: "+e.type+". Try again."));
}

function joinRoom(){
 let id=document.getElementById("room").value.trim();
 if(!id){say("Enter your friend's room ID.");return}
 if(!window.Peer){say("Internet connection required.");return}

 host=false;
 peer=new Peer();

 peer.on("open",myPeerId=>{
  myId=myPeerId;
  let conn=peer.connect(id,{reliable:true});
  connections=[conn];

  conn.on("open",()=>{
   roomId=id;
   say("Connected! Explore the island.");
  });

  conn.on("data",data=>{
   if(data.type==="state"){
    applyState(data.state);
   }
   if(data.type==="full"){
    say("This room is full.");
   }
  });

  conn.on("close",()=>say("Disconnected from room."));
 });
 peer.on("error",e=>say("Could not join room: "+e.type));
}

function copyRoom(){
 if(!roomId){say("Create or join a room first.");return}
 if(navigator.clipboard){
  navigator.clipboard.writeText(roomId)
   .then(()=>say("Room ID copied: "+roomId))
   .catch(()=>say("Your room ID is: "+roomId));
 }else say("Your room ID is: "+roomId);
}

function getState(){
 return {
  players,coins,keys,teamKeys
 };
}

function sync(){
 let state=getState();
 connections=connections.filter(c=>c.open);
 connections.forEach(c=>{
  try{c.send({type:"state",state})}catch(e){}
 });
 updateStats();
}

function applyState(state){
 players=state.players;
 coins=state.coins;
 keys=state.keys;
 teamKeys=state.teamKeys;
 updateStats();
}

function updateStats(){
 document.getElementById("count").textContent=Object.keys(players).length;
 document.getElementById("score").textContent=players[myId]?.score||score;
 document.getElementById("keycount").textContent=teamKeys;
}

function collect(id){
 let p=players[id];
 if(!p)return;

 coins.forEach(c=>{
  if(!c.taken&&Math.hypot(p.x-c.x,p.y-c.y)<22){
   c.taken=true;
   p.score=(p.score||0)+1;
   if(id===myId)score=p.score;
   message("Treasure collected!");
  }
 });

 keys.forEach(k=>{
  if(!k.taken&&Math.hypot(p.x-k.x,p.y-k.y)<24){
   k.taken=true;
   teamKeys++;
   message("A team key was found!");
  }
 });

 if(teamKeys>=3)message("🏆 THE ANCIENT GATE IS UNLOCKED!");
}

function move(dx,dy){
 let speed=3;
 me.x=Math.max(15,Math.min(W-15,me.x+dx*speed));
 me.y=Math.max(15,Math.min(H-15,me.y+dy*speed));

 if(host){
  players[myId]=me;
  collect(myId);
  sync();
 }else if(peer&&roomId){
  connections.forEach(c=>{
   if(c.open)c.send({type:"move",x:me.x,y:me.y});
  });
 }
}

window.addEventListener("keydown",e=>{
 pressed[e.key.toLowerCase()]=true;
});
window.addEventListener("keyup",e=>{
 pressed[e.key.toLowerCase()]=false;
});

document.querySelectorAll("[data-k]").forEach(b=>{
 let k=b.dataset.k;
 b.addEventListener("pointerdown",e=>{
  e.preventDefault();pressed[k]=true;
 });
 ["pointerup","pointerleave","pointercancel"].forEach(ev=>{
  b.addEventListener(ev,()=>pressed[k]=false);
 });
});

function draw(){
 ctx.clearRect(0,0,W,H);
 ctx.fillStyle="#34754b";
 ctx.fillRect(0,0,W,H);

 // Island paths
 ctx.strokeStyle="#b6a06a";
 ctx.lineWidth=42;
 ctx.lineCap="round";
 ctx.beginPath();
 ctx.moveTo(0,480);
 ctx.quadraticCurveTo(330,350,450,270);
 ctx.quadraticCurveTo(650,170,900,40);
 ctx.stroke();

 // Trees
 for(let i=0;i<48;i++){
  let x=(i*173)%W,y=(i*97)%H;
  ctx.fillStyle="#17452e";
  ctx.beginPath();ctx.arc(x,y,19,0,7);ctx.fill();
  ctx.fillStyle="#2c8950";
  ctx.beginPath();ctx.arc(x-3,y-4,14,0,7);ctx.fill();
 }

 // Coins
 coins.forEach(c=>{
  if(!c.taken){
   ctx.fillStyle="#ffd166";
   ctx.beginPath();ctx.arc(c.x,c.y,9,0,7);ctx.fill();
   ctx.strokeStyle="#fff2b2";ctx.stroke();
  }
 });

 // Keys
 keys.forEach(k=>{
  if(!k.taken){
   ctx.font="25px Arial";
   ctx.fillText("🗝️",k.x-12,k.y+9);
  }
 });

 // Ancient gate
 ctx.fillStyle=teamKeys>=3?"#ffd166":"#80613c";
 ctx.fillRect(820,15,50,80);
 ctx.fillStyle="white";
 ctx.font="13px Arial";
 ctx.fillText(teamKeys>=3?"OPEN":"GATE",820,110);

 // Players
 Object.entries(players).forEach(([id,p])=>{
  ctx.fillStyle="#0005";
  ctx.beginPath();ctx.ellipse(p.x,p.y+13,14,6,0,0,7);ctx.fill();
  ctx.fillStyle=p.color;
  ctx.beginPath();ctx.arc(p.x,p.y,13,0,7);ctx.fill();
  ctx.strokeStyle="white";ctx.lineWidth=2;ctx.stroke();
  ctx.fillStyle="white";ctx.font="12px Arial";
  ctx.textAlign="center";
  ctx.fillText(id===myId?"YOU":id.slice(0,6),p.x,p.y-19);
 });
 ctx.textAlign="left";
}

function loop(){
 let dx=0,dy=0;
 if(pressed.arrowleft||pressed.a||pressed.left)dx--;
 if(pressed.arrowright||pressed.d||pressed.right)dx++;
 if(pressed.arrowup||pressed.w||pressed.up)dy--;
 if(pressed.arrowdown||pressed.s||pressed.down)dy++;

 if(dx||dy){
  let len=Math.hypot(dx,dy);
  move(dx/len,dy/len);
 }

 // Host checks its own pickups even when standing still
 if(host)collect(myId);

 draw();
 requestAnimationFrame(loop);
}
loop();
</script>
</body>
</html>
